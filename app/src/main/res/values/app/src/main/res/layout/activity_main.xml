<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="#F8F9FA">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="পূজা এআই অ্যাসিস্ট্যান্ট"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#1A73E8"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="স্ট্যাটাস: সার্ভিস বন্ধ রয়েছে"
        android:textSize="16sp"
        android:textColor="#5F6368"
        android:layout_marginBottom="32dp" />

    <Button
        android:id="@+id/btnToggleService"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="পূজা চালু করুন"
        android:textSize="18sp"
        android:backgroundTint="#1A73E8"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btnAccessibility"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="স্ক্রিন পারমিশন দিন (Accessibility)"
        android:textSize="14sp"
        android:backgroundTint="#34A853"
        android:textColor="#FFFFFF" />

</LinearLayout>
